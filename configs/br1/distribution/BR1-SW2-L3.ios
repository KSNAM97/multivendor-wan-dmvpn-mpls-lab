! cisco
!
hostname br1-sw2-l3
enable secret admin1234
no ip domain-lookup
service timestamps debug datetime msec
service timestamps log datetime msec
!
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 password admin1234
 login
!
vlan 10
 name br1-public
vlan 20
 name br1-private
vlan 100
 name mgmt
vlan 999
 name native
!
int lo0
 ip addr 12.12.12.12 255.255.255.255
!
int range gi1/0 - 1
 desc to br1-sw1-l3 po1
 channel-group 1 mode active
!
int po1
 desc to br1-sw1-l3 po1
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 10,20,100
!
int gi0/0
 desc to br1-r1 gi1/0
 no switchport
 ip addr 10.3.0.10 255.255.255.252
 no sh
!
int gi0/1
 desc to br1-r2 gi1/0
 no switchport
 ip addr 10.3.0.14 255.255.255.252
 no sh
!
int gi2/0
 desc to br1-sw3-l3 gi0/1
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 10,20,100
!
int vlan 100
 ip addr 10.3.100.12 255.255.255.0
 no sh
! stp mst
spanning-tree mode mst
spanning-tree mst configuration
 name br1
 revision 1
 instance 1 vlan 10,20,100
 spanning-tree mst 1 priority 8192
!
ip routing
int vlan10
 desc vrrp backup for br1-sw1-l3 vlan10
 ip addr 10.3.10.3 255.255.255.0
 vrrp 10 ip 10.3.10.1
 vrrp 10 priority 90
 no sh
!
ip routing
int vlan20
 desc vrrp backup for br1-sw1-l3 vlan20
 ip addr 10.3.20.3 255.255.255.0
 vrrp 20 ip 10.3.20.1
 vrrp 20 priority 90
 no sh
!
router ospf 12
 router-id 12.12.12.12
 passive-interface default
 no passive-interface gi0/0
 no passive-interface gi0/1
!
int lo0
 ip ospf 12 area 2
int gi0/0
 ip ospf 12 area 2
 ip ospf network point-to-point
int gi0/1
 ip ospf 12 area 2
 ip ospf network point-to-point
!
int vlan10
 ip ospf 12 area 2
!
int vlan20
 ip ospf 12 area 2
!
service dhcp
ip dhcp excluded-address 10.3.10.1 10.3.10.163
ip dhcp excluded-address 10.3.10.228 10.3.10.254
ip dhcp excluded-address 10.3.20.1 10.3.20.163
ip dhcp excluded-address 10.3.20.228 10.3.20.254
!
ip dhcp pool br1-public
 network 10.3.10.0 255.255.255.0
 default-router 10.3.10.1
 dns-server 10.2.50.10 10.2.50.11
 domain-name lab.local
 lease 1
!
ip dhcp pool br1-private
 network 10.3.20.0 255.255.255.0
 default-router 10.3.20.1
 dns-server 10.2.50.10 10.2.50.11
 domain-name lab.local
 lease 1
!