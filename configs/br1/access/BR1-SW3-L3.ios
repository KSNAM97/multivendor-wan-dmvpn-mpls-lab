! cisco
!
hostname br1-sw3-l3
enable secret admin1234
no ip domain-lookup
service timestamps debug datetime msec
service timestamps log datetime msec
!
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 password admin1234
 login
!
vlan 10
 name br1-user
vlan 100
 name mgmt
vlan 999
 name native
!
int gi0/0
 desc to br1-sw1-l3 gi2/0
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 10,100
!
int gi0/1
 desc to br1-sw2-l3 gi2/0
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 10,100
!
int gi3/0
 desc to br1-pc1 eth0
 switchport access vlan 10
 switchport mode access
 spanning-tree portfast
!
int gi3/1
 desc to br1-pc2 eth0
 switchport access vlan 10
 switchport mode access
 spanning-tree portfast
!
int vlan 100
 ip addr 10.3.100.13 255.255.255.0
 no sh
! stp mst
spanning-tree mode mst
spanning-tree mst configuration
 name br1
 revision 1
 instance 1 vlan 10,100
!
