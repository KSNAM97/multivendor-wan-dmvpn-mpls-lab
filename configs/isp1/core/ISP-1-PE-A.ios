! cisco
!
hostname isp-1-pe-a
enable secret admin1234
no ip domain-lookup
service timestamps debug datetime msec
service timestamps log datetime msec
!
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 password admin1234
 login
!
int lo0
 ip addr 100.100.100.1 255.255.255.255
!
int gi0/0
 desc to isp-1-p1 gi0/0
 ip addr 100.1.0.1 255.255.255.252
 no sh
!
int gi1/0
 desc to isp-1-p2 gi0/0
 ip addr 100.1.0.5 255.255.255.252
 no sh
!
int gi2/0
 desc to hq-r1 gi3/0
 ip addr 100.1.11.2 255.255.255.252
 no sh
!
int gi3/0
 desc to dc-r3 gi3/0
 ip addr 100.1.21.2 255.255.255.252
 no sh
!