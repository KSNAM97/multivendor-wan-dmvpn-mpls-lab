! cisco
!
hostname hq-sw-3
enable secret admin1234
no ip domain-lookup
service timestamps debug datetime msec
service timestamps log datetime msec
!
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 password admin1234
 login
!
int lo0
 ip addr 11.11.11.13 255.255.255.255
!
int gi1/0
 desc to hq-r1 gi1/0
 no switchport
 ip addr 10.1.0.10 255.255.255.252
 no sh
!
int gi1/1
 desc to hq-r2 gi1/0
 no switchport
 ip addr 10.1.0.14 255.255.255.252
 no sh
!
vlan 10
 name hq-public
vlan 20
 name hq-private
vlan 100
 name mgmt
vlan 999
 name native
!
int range gi0/0 - 1
 desc to hq-sw-1 po2
 channel-group 2 mode active
int range gi0/2 - 3
 desc to hq-sw-2 po3
 channel-group 3 mode active
!
int po2
 desc to hq-sw-1 po2
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 10,20,100
int po3
 desc to hq-sw-2 po3
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 10,20,100
!
int vlan 100
 ip addr 10.1.100.13 255.255.255.0
 no sh
!