! cisco
!
hostname hq-r2
enable secret admin1234
no ip domain-lookup
service timestamps debug datetime msec
service timestamps log datetime msec
!
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 password admin1234
 login
!
int lo0
 ip addr 11.11.11.2 255.255.255.255
!
int gi0/0
 desc to hq-sw-2 gi1/1
 ip addr 10.1.0.5 255.255.255.252
 no sh
!
int gi1/0
 desc to hq-sw-3 gi1/1
 ip addr 10.1.0.13 255.255.255.252
 no sh
!
int gi2/0
 desc to hq-r1 gi2/0
 ip addr 10.1.0.18 255.255.255.252
 no sh
!
int gi3/0
 desc to isp-2-pe-a gi2/0
 ip addr 100.2.12.1 255.255.255.252
 no sh
!
int gi4/0
 desc to private-net gi2/0
 ip addr 203.0.113.9 255.255.255.252
 no sh
!
router ospf 11
 router-id 11.11.11.2
 passive-interface default
 no passive-interface gi0/0
 no passive-interface gi1/0
 no passive-interface gi2/0
!
int lo0
 ip ospf 11 area 1
int gi0/0
 ip ospf 11 area 1
 ip ospf network point-to-point
int gi1/0
 ip ospf 11 area 1
 ip ospf network point-to-point
int gi2/0
 ip ospf 11 area 1
 ip ospf network point-to-point
!
router ospf 2
 router-id 11.11.11.2
 passive-interface default
 no passive-interface gi4/0
!
int gi4/0
 ip ospf 2 area 100
 ip ospf network point-to-point
!