! cisco
!
hostname hq-r1
enable secret admin1234
no ip domain-lookup
service timestamps debug datetime msec
service timestamps log datetime msec
!
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 password admin1234
 login
!
int lo0
 ip addr 11.11.11.1 255.255.255.255
!
int gi0/0
 desc to hq-sw-2 gi1/0
 ip addr 10.1.0.1 255.255.255.252
 no sh
!
int gi1/0
 desc to hq-sw-3 gi1/0
 ip addr 10.1.0.9 255.255.255.252
 no sh
!
int gi2/0
 desc to hq-r2 gi2/0
 ip addr 10.1.0.17 255.255.255.252
 no sh
!
int gi3/0
 desc to isp-1-pe-a gi2/0
 ip addr 100.1.11.1 255.255.255.252
 no sh
!
router ospf 11
 router-id 11.11.11.1
 passive-interface default
 no passive-interface gi0/0
 no passive-interface gi1/0
 no passive-interface gi2/0
!
int lo0
 ip ospf 11 area 1
int gi0/0
 ip ospf 11 area 1
 ip ospf network point-to-point
int gi1/0
 ip ospf 11 area 1
 ip ospf network point-to-point
int gi2/0
 ip ospf 11 area 1
 ip ospf network point-to-point
!
