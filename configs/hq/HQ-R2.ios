! cisco
!
hostname hq-r2
enable secret admin1234
no ip domain-lookup
service timestamps debug datetime msec
service timestamps log datetime msec
!
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 password admin1234
 login
!
int lo0
 ip addr 11.11.11.2 255.255.255.255
!
int gi0/0
 desc to hq-sw-2 gi1/1
 ip addr 10.1.0.5 255.255.255.252
 no sh
!
int gi1/0
 desc to hq-sw-3 gi1/1
 ip addr 10.1.0.13 255.255.255.252
 no sh
!
int gi2/0
 desc to hq-r1 gi2/0
 ip addr 10.1.0.18 255.255.255.252
 no sh
!
int gi3/0
 desc to isp-2-pe-a gi2/0
 ip addr 100.2.12.1 255.255.255.252
 no sh
!
int gi4/0
 desc to private-net gi2/0
 ip addr 203.0.113.9 255.255.255.252
 no sh
!
