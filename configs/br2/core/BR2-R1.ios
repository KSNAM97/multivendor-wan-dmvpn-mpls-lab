! cisco
!
hostname br2-r1
enable secret admin1234
no ip domain-lookup
service timestamps debug datetime msec
service timestamps log datetime msec
!
line con 0
 logging synchronous
 exec-timeout 0 0
line vty 0 4
 password admin1234
 login
!
int lo0
 ip addr 13.13.13.1 255.255.255.255
!
int gi0/0
 desc to br2-sw1-l3 gi0/0
 ip addr 10.4.0.1 255.255.255.252
 no sh
!
int gi1/0
 desc to br2-sw2-l3 gi0/0
 ip addr 10.4.0.9 255.255.255.252
 no sh
!
int gi2/0
 desc to br2-r2 gi2/0
 ip addr 10.4.0.17 255.255.255.252
 no sh
!
int gi3/0
 desc to isp-1-pe-b gi3/0
 ip addr 100.1.41.1 255.255.255.252
 no sh
!
router ospf 13
 router-id 13.13.13.1
 passive-interface default
 no passive-interface gi0/0
 no passive-interface gi1/0
 no passive-interface gi2/0
!
int lo0
 ip ospf 13 area 3
!
int gi0/0
 ip ospf 13 area 3
 ip ospf network point-to-point
!
int gi1/0
 ip ospf 13 area 3
 ip ospf network point-to-point
!
int gi2/0
 ip ospf 13 area 3
 ip ospf network point-to-point
!
